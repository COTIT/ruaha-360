# ============================================================
# Ruaha 360 — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed
# and must never contain a real key.
#
# Rule from CLAUDE.md: never commit a service-role key, and never use one
# from the browser. Only VITE_* vars reach the client bundle — anything
# without that prefix stays on your machine and in CI secrets.
# ============================================================

# ── client (bundled into the SPA — public values only) ──────
# Local:  http://127.0.0.1:54321
# Cloud:  https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The anon / publishable key. Safe in the browser by design: it carries no
# authority of its own, RLS decides what the signed-in user may see.
# Local:  printed by `pnpm supabase start`
# Cloud:  Project Settings -> API Keys
VITE_SUPABASE_ANON_KEY=

# Drives the demo banner. Never a database column: the demo instance and any
# future live instance are different databases, so there is no is_demo flag.
VITE_DATA_MODE=demo

# ── tooling (never bundled, never in the browser) ───────────
# Used by supabase/tests/rls_test.sql. This is the name the spec uses.
# Local default below; for cloud use the pooler/direct connection string.
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Cloud project reference, from Project Settings -> General -> Project ID.
# Not a secret: it appears in every API URL.
SUPABASE_PROJECT_REF=

# Personal access token for the CLI (`supabase login` stores this for you;
# set it only for non-interactive use such as CI). SECRET.
SUPABASE_ACCESS_TOKEN=

# Database password for `supabase link` / `db push`. SECRET.
SUPABASE_DB_PASSWORD=

# ── deliberately absent ─────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY — nothing in this app may hold one. It bypasses
# RLS, and RLS is the security boundary. If a task seems to need it, that task
# belongs in a migration or an RPC, not in the client.
